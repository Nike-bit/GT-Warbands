<form class="{{cssClass}} ds-wb-sheet" autocomplete="off">
  <header class="ds-wb-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}">
    <div class="ds-wb-title-block">
      <input class="ds-wb-name" name="name" type="text" value="{{actor.name}}" placeholder="Warband Name">
      <div class="ds-wb-profile-label">{{profile.name}}</div>
    </div>
  </header>

  <section class="ds-wb-top-grid">
    <div class="ds-wb-panel">
      <div class="ds-wb-panel-title">{{profile.labels.power}}</div>
      <a class="ds-wb-derived-big" data-action="roll-power" title="Roll Power check">{{derived.power}}</a>
      <div class="ds-wb-pair-fields">
        <label><span>{{profile.labels.basePower}}</span><input name="system.basePower" type="number" min="0" step="1" value="{{system.basePower}}"></label>
        <label><span>{{profile.labels.veterancy}}</span><input name="system.veterancy" type="number" min="0" step="1" value="{{system.veterancy}}"></label>
      </div>
    </div>

    <div class="ds-wb-panel">
      <div class="ds-wb-panel-title">{{profile.labels.effectiveness}}</div>
      <div class="ds-wb-effectiveness">
        <input name="system.effectiveness.value" type="number" min="0" step="1" value="{{system.effectiveness.value}}">
        <span>/</span><strong>{{system.effectiveness.max}}</strong>
      </div>
      <div class="ds-wb-state ds-wb-state-{{derived.state}}">{{derived.state}}</div>
      <div class="ds-wb-effectiveness-formula">
        Formula: <strong>{{derived.effectivenessFormula}}</strong>
        {{#if staleEffectiveness}}<span class="ds-wb-warning">stats changed</span>{{/if}}
      </div>
      <button type="button" data-action="roll-effectiveness"><i class="fas fa-dice"></i> Roll Effectiveness</button>
    </div>
  </section>

  <section class="ds-wb-combat-strip">
    <div><span>{{profile.labels.attack}}</span><strong>{{derived.attackBonus}}</strong></div>
    <div><span>{{profile.labels.ac}}</span><strong>{{derived.ac}}</strong></div>
    <div><span>{{profile.labels.attacks}}</span><strong>{{derived.attacks}}</strong></div>
    <div><span>{{profile.labels.damage}}</span><strong>{{currentDamage.formula}}</strong>{{#if currentDamage.magical}}<small>{{currentDamage.propertyLabel}}</small>{{/if}}</div>
  </section>

  <section class="ds-wb-section">
    <div class="ds-wb-section-title">ABILITIES</div>
    {{#each abilityRows as |row|}}
    <div class="ds-wb-ability-row">
      {{#each row as |ability|}}
      <div class="ds-wb-ability-card">
        <a data-action="roll-ability" data-ability="{{ability.key}}" class="ds-wb-ability-label">
          <strong>{{ability.label}}</strong><small>{{ability.generic}}</small>
        </a>
        <div class="ds-wb-plus">+</div>
        <input name="system.abilities.{{ability.key}}" type="number" min="0" step="1" value="{{ability.value}}">
      </div>
      {{/each}}
    </div>
    {{/each}}
  </section>

  <section class="ds-wb-section ds-wb-damage-config">
    <div class="ds-wb-section-title">DAMAGE FRAMEWORK</div>
    <div class="ds-wb-config-grid">
      <label>
        <span>{{profile.labels.dominantAbility}}</span>
        <select name="system.dominantAbility">
          {{#each dominantOptions as |opt|}}<option value="{{opt.key}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
        </select>
      </label>
      <label>
        <span>{{profile.labels.extraDamageDice}} (Size / Effects)</span>
        <input name="system.modifiers.extraDamageDice" type="number" step="1" value="{{system.modifiers.extraDamageDice}}">
      </label>
      <label>
        <span>{{profile.damage.ability1CProperty.defenseLabel}}</span>
        <select name="system.defenses.ability1CProperty">
          {{#each defenseOptions as |opt|}}<option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
        </select>
      </label>
    </div>
    <p class="notes">Damage dice come from the Dominant Ability plus Size/effect dice. Might determines die size; Might above the profile cap adds dice. Ability 1C supplies flat damage and can grant a profile-defined attack property.</p>
  </section>

  <section class="ds-wb-section">
    <div class="ds-wb-section-header">
      <div class="ds-wb-section-title">ATTACKS</div>
      <div>
        <button type="button" data-action="melee-exchange" class="ds-wb-compact-button"><i class="fas fa-swords"></i> Melee Exchange</button>
        <button type="button" data-action="create-attack" class="ds-wb-compact-button"><i class="fas fa-plus"></i> Add Attack</button>
      </div>
    </div>
    <div class="item-list ds-wb-attack-list">
      {{#each attacks as |attack|}}
      <div class="item ds-wb-attack-row" data-item-id="{{attack.id}}">
        <a data-action="set-default-attack" title="Set as default attack" class="ds-wb-star"><i class="{{#if attack.isDefault}}fas{{else}}far{{/if}} fa-star"></i></a>
        <a data-action="roll-attack" class="ds-wb-attack-main">
          <strong>{{attack.name}}</strong><span>{{attack.range}}</span><span>{{attack.dominantLabel}}</span><span>{{attack.damageFormula}}</span>{{#if attack.magical}}<small>{{attack.propertyLabel}}</small>{{/if}}
        </a>
        <a data-action="edit-attack" title="Edit"><i class="fas fa-edit"></i></a>
        <a data-action="delete-attack" title="Delete"><i class="fas fa-trash"></i></a>
      </div>
      {{else}}<div class="ds-wb-empty">No Warband Attacks yet.</div>{{/each}}
    </div>
    <p class="notes">Target one Warband and click an attack to preview its attack set. Melee Exchange resolves both Warbands' default melee attacks simultaneously and applies Effectiveness damage. Ranged exchange rules are not automated yet.</p>
  </section>

  <section class="ds-wb-section">
    <div class="ds-wb-section-title">NOTES</div>
    <textarea name="system.notes" rows="6" placeholder="Traits, formations, morale notes, special rules...">{{system.notes}}</textarea>
  </section>
</form>
