<form class="{{cssClass}} gt-wb-sheet" autocomplete="off">
  <header class="gt-wb-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}">
    <div class="gt-wb-title-block">
      <input class="gt-wb-name" name="name" type="text" value="{{actor.name}}" placeholder="{{gtwLocalize "TYPES.Actor.gt-warbands.warband"}}">
      <div class="gt-wb-profile-label">{{profile.name}}</div>
    </div>
  </header>

  <section class="gt-wb-top-grid">
    <div class="gt-wb-panel">
      <div class="gt-wb-panel-title">{{profile.labels.power}}</div>
      <a class="gt-wb-derived-big" data-action="roll-power" title="{{profile.labels.power}}">{{derived.power}}</a>
      <div class="gt-wb-pair-fields">
        <label><span>{{profile.labels.basePower}}</span><input name="system.basePower" type="number" min="0" step="1" value="{{system.basePower}}"></label>
        <label><span>{{profile.labels.veterancy}}</span><input name="system.veterancy" type="number" min="0" step="1" value="{{system.veterancy}}"></label>
      </div>
    </div>

    <div class="gt-wb-panel">
      <div class="gt-wb-panel-title">{{profile.labels.effectiveness}}</div>
      <div class="gt-wb-effectiveness">
        <input name="system.effectiveness.value" type="number" min="0" step="1" value="{{system.effectiveness.value}}">
        <span>/</span><strong>{{system.effectiveness.max}}</strong>
      </div>
      <div class="gt-wb-state gt-wb-state-{{derived.state}}">{{stateLabel}}</div>
      <div class="gt-wb-effectiveness-formula">
        {{gtwLocalize "GTWARBANDS.Sheet.Formula"}}: <strong>{{derived.effectivenessFormula}}</strong>
        {{#if staleEffectiveness}}<span class="gt-wb-warning">{{gtwLocalize "GTWARBANDS.Sheet.StatsChanged"}}</span>{{/if}}
      </div>
      <button type="button" data-action="roll-effectiveness"><i class="fas fa-dice"></i> {{gtwLocalize "GTWARBANDS.Sheet.RollEffectiveness"}}</button>
    </div>
  </section>

  <section class="gt-wb-combat-strip">
    <div><span>{{profile.labels.attack}}</span><strong>{{derived.attackBonus}}</strong></div>
    <div><span>{{profile.labels.ac}}</span><strong>{{derived.ac}}</strong></div>
    <div><span>{{profile.labels.attacks}}</span><strong>{{derived.attacks}}</strong></div>
    <div><span>{{profile.labels.damage}}</span><strong>{{currentDamage.formula}}</strong>{{#if currentDamage.magical}}<small>{{currentDamage.propertyLabel}}</small>{{/if}}</div>
  </section>

  <section class="gt-wb-section">
    <div class="gt-wb-section-title">{{gtwLocalize "GTWARBANDS.Sheet.Abilities"}}</div>
    {{#each abilityRows as |row|}}
    <div class="gt-wb-ability-row">
      {{#each row as |ability|}}
      <div class="gt-wb-ability-card">
        <a data-action="roll-ability" data-ability="{{ability.key}}" class="gt-wb-ability-label">
          <strong>{{ability.label}}</strong><small>{{ability.generic}}</small>
        </a>
        <div class="gt-wb-plus">+</div>
        <input name="system.abilities.{{ability.key}}" type="number" min="0" step="1" value="{{ability.value}}">
      </div>
      {{/each}}
    </div>
    {{/each}}
  </section>

  <section class="gt-wb-section gt-wb-damage-config">
    <div class="gt-wb-section-title">{{gtwLocalize "GTWARBANDS.Sheet.DamageFramework"}}</div>
    <div class="gt-wb-config-grid">
      <label>
        <span>{{profile.labels.dominantAbility}}</span>
        <select name="system.dominantAbility">
          {{#each dominantOptions as |opt|}}<option value="{{opt.key}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
        </select>
      </label>
      <label>
        <span>{{profile.labels.extraDamageDice}} ({{gtwLocalize "GTWARBANDS.Sheet.SizeEffects"}})</span>
        <input name="system.modifiers.extraDamageDice" type="number" step="1" value="{{system.modifiers.extraDamageDice}}">
      </label>
      <label>
        <span>{{profile.damage.ability1CProperty.defenseLabel}}</span>
        <select name="system.defenses.ability1CProperty">
          {{#each defenseOptions as |opt|}}<option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
        </select>
      </label>
    </div>
    <p class="notes">{{gtwLocalize "GTWARBANDS.Sheet.DamageFrameworkHint"}}</p>
  </section>

  <section class="gt-wb-section">
    <div class="gt-wb-section-header">
      <div class="gt-wb-section-title">{{gtwLocalize "GTWARBANDS.Sheet.Attacks"}}</div>
      <div>
        <button type="button" data-action="melee-exchange" class="gt-wb-compact-button"><i class="fas fa-swords"></i> {{gtwLocalize "GTWARBANDS.Sheet.MeleeExchange"}}</button>
        <button type="button" data-action="create-attack" class="gt-wb-compact-button"><i class="fas fa-plus"></i> {{gtwLocalize "GTWARBANDS.Sheet.AddAttack"}}</button>
      </div>
    </div>
    <div class="item-list gt-wb-attack-list">
      {{#each attacks as |attack|}}
      <div class="item gt-wb-attack-row" data-item-id="{{attack.id}}">
        <a data-action="set-default-attack" title="{{gtwLocalize "GTWARBANDS.Sheet.SetDefaultAttack"}}" class="gt-wb-star"><i class="{{#if attack.isDefault}}fas{{else}}far{{/if}} fa-star"></i></a>
        <a data-action="roll-attack" class="gt-wb-attack-main">
          <strong>{{attack.name}}</strong><span>{{attack.rangeLabel}}</span><span>{{attack.dominantLabel}}</span><span>{{attack.damageFormula}}</span>{{#if attack.magical}}<small>{{attack.propertyLabel}}</small>{{/if}}
        </a>
        <a data-action="edit-attack" title="{{gtwLocalize "GTWARBANDS.Sheet.Edit"}}"><i class="fas fa-edit"></i></a>
        <a data-action="delete-attack" title="{{gtwLocalize "GTWARBANDS.Sheet.Delete"}}"><i class="fas fa-trash"></i></a>
      </div>
      {{else}}<div class="gt-wb-empty">{{gtwLocalize "GTWARBANDS.Sheet.NoAttacks"}}</div>{{/each}}
    </div>
    <p class="notes">{{gtwLocalize "GTWARBANDS.Sheet.AttacksHint"}}</p>
  </section>

  <section class="gt-wb-section">
    <div class="gt-wb-section-title">{{gtwLocalize "GTWARBANDS.Sheet.Notes"}}</div>
    <textarea name="system.notes" rows="6" placeholder="{{gtwLocalize "GTWARBANDS.Sheet.NotesPlaceholder"}}">{{system.notes}}</textarea>
  </section>
</form>
