<form class="gt-wb-profile-config" autocomplete="off">
  <h2>Warband Rules Profile</h2>
  <div class="form-group"><label>Active Profile</label><select name="activeProfile">{{#each profiles as |opt|}}<option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}</select></div>
  <p class="notes">Shadowdark (Default) is built in and immutable. Clone it into Custom before changing labels or mathematics.</p>
  <div class="gt-wb-profile-actions"><button type="button" data-action="clone-default"><i class="fas fa-copy"></i> Clone Default to Custom</button><button type="button" data-action="reset-custom"><i class="fas fa-rotate-left"></i> Reset Custom</button></div>

  <h2>Custom Profile</h2>
  <div class="form-group"><label>Profile Name</label><input type="text" name="custom.name" value="{{custom.name}}"></div>

  <h3>Quality Labels</h3>
  <div class="gt-wb-profile-grid">{{#each qualityLabelRows as |quality|}}<label><span>{{quality.generic}}</span><input type="text" name="custom.labels.{{quality.key}}" value="{{quality.label}}"></label>{{/each}}</div>

  <h3>Ability Labels</h3>
  <div class="gt-wb-profile-grid">{{#each abilityRows as |ability|}}<label><span>{{ability.generic}}</span><input type="text" name="custom.abilities.{{ability.key}}.label" value="{{ability.label}}"></label>{{/each}}</div>

  <h3>Core Formulas</h3>
  <p class="notes">Variables: basePower, veterancy, power, ability1A, ability2A, ability1B, ability2B, ability1C, ability2C, dominantAbility, extraDamageDice, mightCap. Functions: floor, ceil, round, min, max, abs.</p>
  {{#each formulaRows as |row|}}<div class="form-group"><label>{{row.label}}</label><input type="text" name="custom.formulas.{{row.key}}" value="{{row.value}}"></div>{{/each}}

  <h3>Effectiveness</h3>
  <div class="form-group"><label>Effectiveness Die Faces</label><input type="number" min="2" step="1" name="custom.effectiveness.dieFaces" value="{{custom.effectiveness.dieFaces}}"></div>
  <div class="form-group"><label>Full threshold</label><input type="number" min="0.01" max="0.99" step="0.01" name="custom.effectiveness.bands.full" value="{{custom.effectiveness.bands.full}}"></div>
  <div class="form-group"><label>Half threshold</label><input type="number" min="0" max="0.98" step="0.01" name="custom.effectiveness.bands.half" value="{{custom.effectiveness.bands.half}}"></div>

  <h3>Might Damage Die</h3>
  <div class="form-group"><label>Might cap before overflow dice</label><input type="number" min="0" step="1" name="custom.damage.mightCap" value="{{custom.damage.mightCap}}"></div>
  <div class="gt-wb-die-grid">
    <label><span>Might +0</span><input type="number" min="2" step="1" name="custom.damage.mightDieFaces.0" value="{{custom.damage.mightDieFaces.0}}"></label>
    <label><span>Might +1</span><input type="number" min="2" step="1" name="custom.damage.mightDieFaces.1" value="{{custom.damage.mightDieFaces.1}}"></label>
    <label><span>Might +2</span><input type="number" min="2" step="1" name="custom.damage.mightDieFaces.2" value="{{custom.damage.mightDieFaces.2}}"></label>
    <label><span>Might +3</span><input type="number" min="2" step="1" name="custom.damage.mightDieFaces.3" value="{{custom.damage.mightDieFaces.3}}"></label>
    <label><span>Might +4</span><input type="number" min="2" step="1" name="custom.damage.mightDieFaces.4" value="{{custom.damage.mightDieFaces.4}}"></label>
    <label><span>Might +5</span><input type="number" min="2" step="1" name="custom.damage.mightDieFaces.5" value="{{custom.damage.mightDieFaces.5}}"></label>
  </div>

  <h3>Ability-triggered Attack Property</h3>
  <div class="form-group"><label>Source Ability</label><select name="custom.damage.ability1CProperty.abilityKey">{{#each propertyAbilityOptions as |opt|}}<option value="{{opt.key}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}</select></div>
  <div class="form-group"><label>Threshold</label><input type="number" step="1" name="custom.damage.ability1CProperty.threshold" value="{{custom.damage.ability1CProperty.threshold}}"></div>
  <div class="form-group"><label>Attack Property Label</label><input type="text" name="custom.damage.ability1CProperty.label" value="{{custom.damage.ability1CProperty.label}}"></div>
  <div class="form-group"><label>Defense Label</label><input type="text" name="custom.damage.ability1CProperty.defenseLabel" value="{{custom.damage.ability1CProperty.defenseLabel}}"></div>

  <footer class="sheet-footer"><button type="submit"><i class="fas fa-save"></i> Save Profile</button></footer>
</form>
