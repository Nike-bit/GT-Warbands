<form
  class="{{cssClass}} flexcol gt-wb-enhanced-npc-attack-sheet"
  autocomplete="off"
  data-gt-warbands-enhanced-npc-attack="true"
>
  {{> items/_partials/header }}

  <nav class="SD-nav flex0" data-group="primary">
    <a class="navigation-tab" data-tab="tab-details">
      {{localize "SHADOWDARK.sheet.item.tab.details"}}
    </a>
    <a class="navigation-tab" data-tab="tab-description">
      {{localize "SHADOWDARK.sheet.item.tab.description"}}
    </a>
    <a class="navigation-tab" data-tab="tab-source">
      {{localize "SHADOWDARK.sheet.item.tab.source"}}
    </a>
  </nav>

  <section class="SD-content-body flex1">
    <section class="tab tab-details" data-group="primary" data-tab="tab-details">
      <div class="gt-wb-enhanced-npc-attack {{#if gtw.ds.active}}has-ds-compatibility{{/if}}">
        <section class="gt-wb-enhanced-attack-block {{#if gtw.skirmish}}gt-wb-skirmish-profiles{{else}}gt-wb-enhanced-attack-configuration{{/if}}">
        {{#if gtw.skirmish}}
            <h2>{{gtwLocalize "GTWARBANDS.Skirmish.ConditionProfiles"}}</h2>

            <label class="gt-wb-skirmish-condition-control">
              <span>{{gtwLocalize "GTWARBANDS.Skirmish.ConditionOverride"}}</span>
              <select data-gtw-condition-override {{#unless gtw.canOverrideCondition}}disabled{{/unless}}>
                {{#each gtw.conditionOptions as |option|}}
                  <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
                {{/each}}
              </select>
            </label>

            <div class="gt-wb-skirmish-profile-grid {{#if gtw.ds.active}}has-ds-compatibility{{/if}}">
              <strong>{{gtwLocalize "GTWARBANDS.Skirmish.Condition"}}</strong>
              <strong>{{gtwLocalize "GTWARBANDS.Skirmish.NumAttacks"}}</strong>
              <strong>{{gtwLocalize "GTWARBANDS.Skirmish.AttackBonus"}}</strong>
              <strong>{{gtwLocalize "GTWARBANDS.Skirmish.DamageFormula"}}</strong>
              <strong>{{localize "SHADOWDARK.item.effect.predefined_effect.critMultiplier"}}</strong>
              {{#if gtw.ds.active}}<strong>{{gtw.ds.magicalLabel}}</strong>{{/if}}

              {{#each gtw.profiles as |profile|}}
                <div
                  class="gt-wb-skirmish-profile-row {{#if ../gtw.ds.active}}has-ds-compatibility{{/if}} {{#if profile.active}}is-active{{/if}} {{#if profile.manual}}is-manual{{/if}}"
                  data-condition="{{profile.condition}}"
                >
                  <strong>{{profile.label}}</strong>
                  <div class="gt-wb-skirmish-profile-field {{#if profile.manualFields.attackCount}}is-manual{{/if}}">
                    <input
                      type="number"
                      min="1"
                      step="1"
                      value="{{profile.attackCount}}"
                      data-profile-field="attackCount"
                      aria-label="{{gtwLocalize 'GTWARBANDS.Skirmish.NumAttacks'}}"
                      {{#unless profile.editable}}disabled{{/unless}}
                    >
                    <button
                      type="button"
                      data-action="gtw-reset-profile-field"
                      data-profile-field="attackCount"
                      data-tooltip="{{gtwLocalize 'GTWARBANDS.Skirmish.ResetAutomatic'}}"
                      aria-label="{{gtwLocalize 'GTWARBANDS.Skirmish.ResetAutomatic'}}"
                      {{#unless profile.canResetFields.attackCount}}disabled{{/unless}}
                    ><i class="fas fa-rotate-left" aria-hidden="true"></i></button>
                  </div>
                  <div class="gt-wb-skirmish-profile-field {{#if profile.manualFields.attackBonus}}is-manual{{/if}}">
                    <input
                      type="text"
                      value="{{profile.attackBonus}}"
                      data-profile-field="attackBonus"
                      aria-label="{{gtwLocalize 'GTWARBANDS.Skirmish.AttackBonus'}}"
                      {{#unless profile.editable}}disabled{{/unless}}
                    >
                    <button
                      type="button"
                      data-action="gtw-reset-profile-field"
                      data-profile-field="attackBonus"
                      data-tooltip="{{gtwLocalize 'GTWARBANDS.Skirmish.ResetAutomatic'}}"
                      aria-label="{{gtwLocalize 'GTWARBANDS.Skirmish.ResetAutomatic'}}"
                      {{#unless profile.canResetFields.attackBonus}}disabled{{/unless}}
                    ><i class="fas fa-rotate-left" aria-hidden="true"></i></button>
                  </div>
                  <div class="gt-wb-skirmish-profile-field {{#if profile.manualFields.damage}}is-manual{{/if}}">
                    <input
                      type="text"
                      value="{{profile.damage}}"
                      data-profile-field="damage"
                      aria-label="{{gtwLocalize 'GTWARBANDS.Skirmish.DamageFormula'}}"
                      {{#unless profile.editable}}disabled{{/unless}}
                    >
                    <button
                      type="button"
                      data-action="gtw-reset-profile-field"
                      data-profile-field="damage"
                      data-tooltip="{{gtwLocalize 'GTWARBANDS.Skirmish.ResetAutomatic'}}"
                      aria-label="{{gtwLocalize 'GTWARBANDS.Skirmish.ResetAutomatic'}}"
                      {{#unless profile.canResetFields.damage}}disabled{{/unless}}
                    ><i class="fas fa-rotate-left" aria-hidden="true"></i></button>
                  </div>
                  <div class="gt-wb-skirmish-profile-field {{#if profile.manualFields.criticalMultiplier}}is-manual{{/if}}">
                    <input
                      type="number"
                      min="1"
                      step="1"
                      value="{{profile.criticalMultiplier}}"
                      data-profile-field="criticalMultiplier"
                      aria-label="{{localize 'SHADOWDARK.item.effect.predefined_effect.critMultiplier'}}"
                      {{#unless profile.editable}}disabled{{/unless}}
                    >
                    <button
                      type="button"
                      data-action="gtw-reset-profile-field"
                      data-profile-field="criticalMultiplier"
                      data-tooltip="{{gtwLocalize 'GTWARBANDS.Skirmish.ResetAutomatic'}}"
                      aria-label="{{gtwLocalize 'GTWARBANDS.Skirmish.ResetAutomatic'}}"
                      {{#unless profile.canResetFields.criticalMultiplier}}disabled{{/unless}}
                    ><i class="fas fa-rotate-left" aria-hidden="true"></i></button>
                  </div>
                  {{#if ../gtw.ds.active}}
                    <div class="gt-wb-skirmish-profile-field gt-wb-skirmish-magical-field {{#if profile.manualFields.magical}}is-manual{{/if}}">
                      <input
                        type="checkbox"
                        data-profile-field="magical"
                        data-gtw-previous="{{profile.magical}}"
                        aria-label="{{../gtw.ds.magicalLabel}}"
                        {{checked profile.magical}}
                        {{#unless profile.editable}}disabled{{/unless}}
                      >
                      <button
                        type="button"
                        data-action="gtw-reset-profile-field"
                        data-profile-field="magical"
                        data-tooltip="{{gtwLocalize 'GTWARBANDS.Skirmish.ResetAutomatic'}}"
                        aria-label="{{gtwLocalize 'GTWARBANDS.Skirmish.ResetAutomatic'}}"
                        {{#unless profile.canResetFields.magical}}disabled{{/unless}}
                      ><i class="fas fa-rotate-left" aria-hidden="true"></i></button>
                    </div>
                  {{/if}}
                </div>
              {{/each}}
            </div>
        {{else}}
            <h2>{{gtwLocalize "GTWARBANDS.Skirmish.AttackConfiguration"}}</h2>

            <div class="gt-wb-enhanced-attack-config-grid {{#if gtw.ds.active}}has-ds-compatibility{{/if}}">
              <label class="gt-wb-enhanced-field">
                <strong>{{localize "SHADOWDARK.item.npc_attack_count"}}</strong>
                <input name="system.attack.num" type="text" value="{{item.system.attack.num}}">
              </label>

              <label class="gt-wb-enhanced-field">
                <strong>{{localize "SHADOWDARK.item.npc_attack_bonus"}}</strong>
                {{numberInput system.bonuses.attackBonus name="system.bonuses.attackBonus" placeholder="1"}}
              </label>

              <label class="gt-wb-enhanced-field">
                <strong>{{localize "SHADOWDARK.item.npc_attack_damage_formula"}}</strong>
                <input name="system.damage.value" type="text" value="{{item.system.damage.value}}">
              </label>

              <label class="gt-wb-enhanced-field">
                <strong>{{localize "SHADOWDARK.item.effect.predefined_effect.critMultiplier"}}</strong>
                {{numberInput system.bonuses.critical.multiplier name="system.bonuses.critical.multiplier" placeholder="2"}}
              </label>

              {{#if gtw.ds.active}}
                <label class="gt-wb-enhanced-field gt-wb-ds-magical-field">
                  <strong>{{gtw.ds.magicalLabel}}</strong>
                  <input
                    type="checkbox"
                    data-gtw-ds-field="magical"
                    data-gtw-previous="{{gtw.ds.magical}}"
                    {{checked gtw.ds.magical}}
                    {{#unless gtw.ds.editable}}disabled{{/unless}}
                  >
                </label>
              {{/if}}
            </div>
        {{/if}}

          <div class="gt-wb-enhanced-attack-secondary-grid {{#if gtw.ds.active}}has-ds-compatibility{{/if}}">
            <div class="gt-wb-enhanced-field gt-wb-enhanced-ranges">
              <strong>{{localize "SHADOWDARK.app.npc_attack_ranges.title"}}</strong>
              <a data-action="npc-attack-ranges">
                <div class="properties-list">{{npcAttackRangesDisplay}}</div>
              </a>
            </div>

            <label class="gt-wb-enhanced-field">
              <strong>{{localize "SHADOWDARK.item.npc_attack_special"}}</strong>
              <input
                name="system.damage.special"
                placeholder="{{localize 'SHADOWDARK.item.npc_attack_special_placeholder'}}"
                type="text"
                value="{{item.system.damage.special}}"
              >
            </label>

            {{#if gtw.ds.active}}
              <label class="gt-wb-enhanced-field gt-wb-ds-ability-field">
                <strong>{{gtw.ds.abilityLabel}}</strong>
                <select
                  data-gtw-ds-field="ability"
                  data-gtw-previous="{{gtw.ds.selectedAbility}}"
                  {{#unless gtw.ds.editable}}disabled{{/unless}}
                >
                  {{#each gtw.ds.abilities as |ability|}}
                    <option value="{{ability.value}}" {{#if ability.selected}}selected{{/if}}>{{ability.label}}</option>
                  {{/each}}
                </select>
              </label>
            {{/if}}
          </div>
        </section>
      </div>
    </section>

    {{> items/_partials/description-tab }}
    {{> items/_partials/source-tab }}
  </section>
</form>
