<form class="{{cssClass}} gt-wb-attack-sheet" autocomplete="off">
  <header class="gt-wb-item-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}">
    <input name="name" type="text" value="{{item.name}}" placeholder="{{localize "GTWARBANDS.AttackSheet.AttackName"}}">
  </header>
  <div class="gt-wb-section">
    <div class="form-group"><label>{{localize "GTWARBANDS.AttackSheet.RangeType"}}</label><select name="system.range">{{#each rangeOptions as |opt|}}<option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}</select></div>
    <div class="form-group"><label>{{profile.labels.dominantAbility}}</label><select name="system.dominantAbility">{{#each dominantOptions as |opt|}}<option value="{{opt.key}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}</select></div>
    <div class="form-group"><label>{{localize "GTWARBANDS.AttackSheet.ExtraDamageDice"}}</label><input name="system.extraDamageDice" type="number" step="1" value="{{system.extraDamageDice}}"></div>
  </div>
  {{#if damage}}
  <div class="gt-wb-item-preview">
    <h3>{{localize "GTWARBANDS.AttackSheet.CurrentResult"}}</h3>
    <p><strong>{{profile.labels.damage}}:</strong> {{damage.formula}}</p>
    <p><strong>{{localize "GTWARBANDS.AttackSheet.BaseDice"}}:</strong> {{damage.baseDice}} | <strong>{{localize "GTWARBANDS.AttackSheet.AdditionalDice"}}:</strong> {{damage.addedDice}}</p>
    {{#if damage.magical}}<p><strong>{{localize "GTWARBANDS.AttackSheet.Property"}}:</strong> {{damage.propertyLabel}}</p>{{/if}}
  </div>
  {{else}}<p class="notes">{{localize "GTWARBANDS.AttackSheet.EmbedHint"}}</p>{{/if}}
  <div class="gt-wb-section"><label>{{localize "GTWARBANDS.Sheet.Notes"}}</label><textarea name="system.notes" rows="8">{{system.notes}}</textarea></div>
</form>
